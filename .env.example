# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/stationx

# Frontend URL (CORS origin)
FRONTEND_URL=http://localhost:3000

# JWT Secrets (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-random-secret

# Seed admin (optional — creates on first startup)
SEED_ADMIN_EMAIL=admin@restaurant.com
SEED_ADMIN_PASSWORD=Admin1234

# Email (password reset)
EMAIL_FROM=noreply@stationx.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_STRICT_MAX=5

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_ROOT_FOLDER=stationx

# Upload limits
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
UPLOAD_RATE_LIMIT_MAX=20
