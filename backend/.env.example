PORT=4000
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/stationx
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
SEED_ADMIN_EMAIL=admin@restaurant.com
SEED_ADMIN_PASSWORD=your-admin-password-here
EMAIL_FROM=noreply@stationx.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_STRICT_MAX=5

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_ROOT_FOLDER=stationx

# Upload limits
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
UPLOAD_RATE_LIMIT_MAX=20
